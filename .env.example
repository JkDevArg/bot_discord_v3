# =============================================================================
# DISCORD BOT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Discord Configuration
# -----------------------------------------------------------------------------
# Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Your Discord server (guild) ID
DISCORD_GUILD_ID=your_guild_id_here

# Comma-separated list of admin Discord user IDs
ADMIN_USER_IDS=your_discord_user_id_here

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://username:password@host:port/database
# For Docker: use 'db' as host (service name in docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@db:5432/botdiscord

# PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=botdiscord

# -----------------------------------------------------------------------------
# Web Panel Configuration
# -----------------------------------------------------------------------------
# Secret key for JWT tokens and session encryption
# Generate a secure random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_SECRET_KEY=change_this_to_a_random_secure_string

# Web server host and port
WEB_HOST=0.0.0.0
WEB_PORT=8000

# -----------------------------------------------------------------------------
# Points System Configuration
# -----------------------------------------------------------------------------
# Points awarded per message
POINTS_PER_MESSAGE=10

# Cooldown between messages (seconds)
MESSAGE_COOLDOWN=10

# Maximum points per hour
MAX_POINTS_PER_HOUR=100

# Days of inactivity before penalty
INACTIVITY_DAYS=60

# Penalty percentage (0.25 = 25% reduction)
INACTIVITY_PENALTY=0.25

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# Enable automatic backups
BACKUP_ENABLED=true

# Days to retain backups
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Environment: development or production
ENVIRONMENT=production
