# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Admin Configuration (comma-separated user IDs)
ADMIN_USER_IDS=123456789,987654321

# Points System Configuration
POINTS_PER_MESSAGE=10
MESSAGE_COOLDOWN=60
MAX_POINTS_PER_HOUR=100
INACTIVITY_DAYS=60
INACTIVITY_PENALTY=0.25

# Database Configuration
DATABASE_URL=sqlite:///data/bot.db

# Web Panel Configuration
WEB_SECRET_KEY=your_secret_key_here_change_in_production
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# Monitoring (opcional - configurar después)
SENTRY_DSN=
HEALTHCHECK_BACKUP_URL=
HEALTHCHECK_INACTIVITY_URL=
DISCORD_WEBHOOK_ALERTS=

# Environment
ENVIRONMENT=development

# Discord Webhook para logs (panel web)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
